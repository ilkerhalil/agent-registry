# Registry veritabanı (docker compose servisi: db)
DATABASE_URL=postgresql://registry:registry@127.0.0.1:5433/agentregistry

# Manifest imzalama anahtarı — ÜRETİMDE MUTLAKA DEĞİŞTİRİN
# Kodda asla gömülü olmaz; ortamdan okunur.
REGISTRY_SIGNING_KEY=dev-only-change-me

# İmzalı manifest yanıtının geçerlilik süresi (saniye)
RESOLVE_TTL_SECONDS=300

# Katalog dosyaları (CI kapısı bunları okur)
CATALOG_DIR=./catalogs

# API anahtarları — Bearer token olarak kullanılır (JSON).
# Roller: runtime (yalnız resolve) · publisher (yazma uçları) · security (block + audit).
# ÜRETİMDE MUTLAKA DEĞİŞTİRİN; anahtar tanımlı değilse sunucu başlamaz.
REGISTRY_API_KEYS={"dev-publisher":{"actor":"dev-ci","roles":["publisher"],"tenants":["denizbank"]},"dev-runtime":{"actor":"dev-runtime","roles":["runtime"],"tenants":["denizbank"]},"dev-security":{"actor":"dev-security","roles":["security"],"tenants":["*"]}}
